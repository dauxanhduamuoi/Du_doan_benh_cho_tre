# ==============================
# Bảo mật backend
# ==============================

# Bắt buộc khi khởi động. Dùng chuỗi ngẫu nhiên riêng tối thiểu 32 ký tự; không commit giá trị thật.
SECRET_KEY=

# ==============================
# PubMed / NCBI
# ==============================

# Email liên hệ dùng khi backend gọi PubMed API
NCBI_EMAIL=

# Không bắt buộc. API key NCBI nếu cần hạn mức gọi cao hơn
NCBI_API_KEY=

# Tên công cụ gửi tới NCBI. Thường không cần thay đổi
NCBI_TOOL=weather_ai_v3_medical_knowledge

# ==============================
# Nhà cung cấp AI đang dùng
# ==============================

# Khuyến nghị hiện tại: Groq. Có thể đổi thành ollama hoặc openai
MEDICAL_KNOWLEDGE_LLM_PROVIDER=groq

# ==============================
# Groq API — lựa chọn khuyến nghị hiện tại
# ==============================

# API key lấy từ Groq Console. Không chia sẻ và không commit key thật
GROQ_API_KEY=

# Model khuyến nghị hiện tại; có thể đổi bằng cấu hình nếu model thay đổi
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45

# ==============================
# Ollama local — tùy chọn
# ==============================

# Chỉ dùng khi MEDICAL_KNOWLEDGE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Tên model đã được người dùng cài thủ công trong Ollama
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# ==============================
# OpenAI — provider tùy chọn
# ==============================

# Chỉ dùng khi MEDICAL_KNOWLEDGE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Phiên bản prompt hiện tại
MEDICAL_KNOWLEDGE_PROMPT_VERSION=medical_knowledge_v4_general_factors

# Tùy chọn nâng cao dùng cho provider OpenAI; giữ nguyên nếu không cần thay đổi
MEDICAL_KNOWLEDGE_LLM_TIMEOUT_SECONDS=45
MEDICAL_KNOWLEDGE_LLM_MAX_INPUT_CHARS=60000
MEDICAL_KNOWLEDGE_LLM_MAX_SOURCES=10

# Giá»›i háº¡n deterministic cho evidence text cá»§a má»—i source trÆ°á»›c khi gá»­i provider
MEDICAL_KNOWLEDGE_EVIDENCE_MAX_CHARS_PER_SOURCE=6000

# ==============================
# Auto Medical Knowledge — mặc định tắt và không hiển thị
# ==============================
AUTO_MEDICAL_KNOWLEDGE_DISPLAY_MODE=REVIEWED_ONLY
AUTO_MEDICAL_KNOWLEDGE_MAX_SOURCES=10
AUTO_MEDICAL_KNOWLEDGE_MAX_CONCURRENT_JOBS=1
AUTO_MEDICAL_KNOWLEDGE_MAX_RETRIES=3
AUTO_MEDICAL_KNOWLEDGE_MAX_STRUCTURAL_RETRIES=1
AUTO_MEDICAL_KNOWLEDGE_RETRY_DELAY_SECONDS=300
AUTO_MEDICAL_KNOWLEDGE_GROQ_RATE_LIMIT_COOLDOWN_SECONDS=300
AUTO_MEDICAL_KNOWLEDGE_POLL_SECONDS=5
AUTO_MEDICAL_KNOWLEDGE_INSUFFICIENT_STALE_DAYS=30
AUTO_MEDICAL_KNOWLEDGE_AUTO_VISIBLE=0
AUTO_MEDICAL_KNOWLEDGE_PROMPT_VERSION=medical_knowledge_auto_v2_numeric_claims
AUTO_MEDICAL_KNOWLEDGE_SEARCHES_PER_TOPIC=3
AUTO_MEDICAL_KNOWLEDGE_RESULTS_PER_SEARCH=15
