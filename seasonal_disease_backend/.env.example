# ==============================
# PubMed / NCBI
# ==============================

# Email liên hệ dùng khi backend gọi PubMed API
NCBI_EMAIL=

# Không bắt buộc. API key NCBI nếu cần hạn mức gọi cao hơn
NCBI_API_KEY=

# Tên công cụ gửi tới NCBI. Thường không cần thay đổi
NCBI_TOOL=weather_ai_v3_medical_knowledge

# ==============================
# Nhà cung cấp AI đang dùng
# ==============================

# Khuyến nghị hiện tại: Groq. Có thể đổi thành ollama hoặc openai
MEDICAL_KNOWLEDGE_LLM_PROVIDER=groq

# ==============================
# Groq API — lựa chọn khuyến nghị hiện tại
# ==============================

# API key lấy từ Groq Console. Không chia sẻ và không commit key thật
GROQ_API_KEY=

# Model khuyến nghị hiện tại; có thể đổi bằng cấu hình nếu model thay đổi
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45

# ==============================
# Ollama local — tùy chọn
# ==============================

# Chỉ dùng khi MEDICAL_KNOWLEDGE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Tên model đã được người dùng cài thủ công trong Ollama
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# ==============================
# OpenAI — provider tùy chọn
# ==============================

# Chỉ dùng khi MEDICAL_KNOWLEDGE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Phiên bản prompt hiện tại
MEDICAL_KNOWLEDGE_PROMPT_VERSION=medical_knowledge_v1

# Tùy chọn nâng cao dùng cho provider OpenAI; giữ nguyên nếu không cần thay đổi
MEDICAL_KNOWLEDGE_LLM_TIMEOUT_SECONDS=45
MEDICAL_KNOWLEDGE_LLM_MAX_INPUT_CHARS=60000
MEDICAL_KNOWLEDGE_LLM_MAX_SOURCES=8
